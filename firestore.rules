rules_version = '2';

// Toda la lectura y escritura pasa por el backend (SDK de administrador, que ignora estas reglas).
// Desde el navegador o una app nadie puede leer ni escribir directamente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
