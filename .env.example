GOOGLE_CLIENT_ID=PEGA_AQUI_TU_CLIENT_ID.apps.googleusercontent.com
JWT_SECRET=cambia_este_secreto
MONGO_URI=mongodb://127.0.0.1:27017/synapsis_db
PORT=5000

# Frontend (Vite)
VITE_GOOGLE_CLIENT_ID=PEGA_AQUI_TU_CLIENT_ID.apps.googleusercontent.com

# Firebase (Firestore): guarda sesiones, intentos y rachas. Solo lo usa el backend.
# Opción A: ruta al JSON de la cuenta de servicio (no se sube a git)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Opción B (hostings): el JSON completo en una sola línea, o en base64
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Zona horaria con la que se cuentan los días de la racha
APP_TIMEZONE=America/Mexico_City
# Solo para pruebas locales con el emulador (npm run emulator)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
